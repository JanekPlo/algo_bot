# =============================================================================
# .env.example — algo_bot (ADR-015)
#
# Skopiuj do .env i uzupełnij realnymi kluczami:
#     cp .env.example .env
#
# .env jest w .gitignore — NIGDY nie commituj sekretów. Testnet-first:
# do live paper testingu wystarczą klucze TESTNET (zero-risk). Klucze mainnet
# dopiero w Fazie 3 (Paper/Live Trading).
# =============================================================================

# --- Bybit v5 (linear USDT perpetuals) — ADR-015 ---
# Testnet (https://testnet.bybit.com) — do sanity / paper testingu:
BYBIT_API_KEY_TESTNET=
BYBIT_API_SECRET_TESTNET=

# Mainnet (realny kapitał — Faza 3). Zostaw puste dopóki nie zaczynasz live:
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Binance Futures (legacy baseline — nie usuwamy, ADR-014/015) ---
# Testnet (https://testnet.binancefuture.com):
BINANCE_FUTURES_API_KEY_TESTNET=
BINANCE_FUTURES_API_SECRET_TESTNET=

# Mainnet (legacy; Binance nieaktywny w UE dla Janka — patrz ADR-015 Context):
BINANCE_API_KEY=
BINANCE_API_SECRET=
